<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quota_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/quota_widget_background">

    <TextView
        android:id="@+id/quota_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DeepSeek API"
        android:textColor="#BCEAD9"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/quota_widget_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="打开应用加载演示数据"
        android:textColor="#FFFFFF"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/quota_widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="模拟快照 · 未连接真实账户"
        android:textColor="#9CAEB1"
        android:textSize="11sp" />
</LinearLayout>
