<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quota_row_root" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingTop="10dp" android:paddingBottom="10dp">
    <TextView android:id="@+id/quota_row_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#BCEAD9" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/quota_row_value" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
    <TextView android:id="@+id/quota_row_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#9CAEB1" android:textSize="11sp" />
</LinearLayout>
